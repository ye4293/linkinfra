# 后端环境变量示例。复制为 .env 后填真实值。
#
# .env 已被 .gitignore 覆盖，绝不要把真实凭据写进 docker-compose.yml
# ——那个文件受 git 跟踪，写进去等于发布到远端。

# ============================================================
# 数据库与缓存
# ============================================================

# PostgreSQL（推荐）
# github_id / google_id 的**部分唯一索引**只在 PostgreSQL 与 SQLite 生效，
# 它是唯一能真正关掉「并发注册同一 provider id 建出两个账号、各发一份
# 注册赠额」这个竞态的东西。
SQL_DSN=postgres://user:password@host:5432/dbname

# MySQL 也能跑，但 MySQL 不支持部分索引：启动时会打一条 warning 并跳过
# 索引创建，上面那个竞态只剩应用层「先查再建」，窗口关不掉。
# SQL_DSN=user:password@tcp(host:3306)/dbname?charset=utf8mb4&parseTime=True&loc=Local

REDIS_CONN_STRING=rediss://user:password@host:6379

# session 加密密钥。不设则每次重启随机生成 —— 多实例部署或重启后
# 所有用户的登录态都会失效。openssl rand -base64 32
SESSION_SECRET=

# ============================================================
# OAuth 登录（本轮新增，缺任一个都有明确后果）
# ============================================================

# 与前端 linkinfra-web 配同一个值。
#
# /api/{github,google}/login 接收的是「用户已通过 OAuth 认证」这个断言，
# 而 code 交换发生在前端（next-auth 持有 client secret），后端无法自证
# 断言真伪、只能验证说话的人是谁。没有这道密钥时，任何人拿着公开可查的
# GitHub 数字 id（api.github.com/users/<login> 即可查到）直接 POST 就能
# 取得对方的 session 与 access_token —— 零凭证的全量账号接管。
#
# 未配置时这两个端点一律返回 503（fail closed）：放行的话漏配不会有任何
# 症状，线上会长期裸奔而无人察觉。
#
# 前端那侧的变量名相同，但**绝不能加 NEXT_PUBLIC_ 前缀** —— 带前缀会被
# 内联进客户端 bundle，等于把密钥公开发布。
# openssl rand -base64 32
OAUTH_LOGIN_SECRET=

# /api/* 的 CORS 白名单，逗号分隔，填前端的 origin。
#
# /api/* 走 session cookie 认证。未配置时退回宽松模式（只打告警、不阻断
# ——因为配错会让整个管理后台立刻不可用，比维持现状更糟），但那意味着
# 任何网站都能带着已登录用户的 cookie 读走他的 API key、额度、调用日志。
#
# /v1/* 与 /dashboard/* 不受此限制：它们走 Bearer token，浏览器不会自动
# 附上 token，收紧 origin 反而会打断在自己网页里调 API 的用户。
ALLOWED_ORIGINS=https://app.example.com

# ============================================================
# 前端地址（已废弃）
# ============================================================

# 后端根路径现返回一段纯 JSON（仿 https://api.openai.com/ 根路径响应），
# 不再服务内嵌 React UI，因此 FRONTEND_BASE_URL 已不再被代码读取，
# 可从 .env 删除。前端地址由前端 linkinfra-web 自行配置。
# FRONTEND_BASE_URL=https://app.example.com
